<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no, viewport-fit=cover">
<title>CYBER BLOCKS - MATRIX TRIS</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">

<style>
    :root {
        --bg-color: #05010f;
        --text-color: #00fff2;      /* neon cyan */
        --accent-color: #ff2e92;    /* neon magenta */
        --neon-yellow: #ffe45e;
        --neon-purple: #7b2ff7;
    }

    html, body {
        width: 100%;
        height: 100%;
        margin: 0;
        padding: 0;
        overflow: hidden;
        background-color: var(--bg-color);
    }

    body {
        color: var(--text-color);
        font-family: 'Courier New', Courier, monospace;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: space-between;
        box-sizing: border-box;
        padding-top: env(safe-area-inset-top, 5px);
        padding-bottom: calc(env(safe-area-inset-bottom, 0px) + 15px);
        padding-left: 10px;
        padding-right: 10px;
        background: radial-gradient(ellipse at 50% 25%, #2a0e57 0%, #0a0420 55%, #030110 100%);
        touch-action: none;
        -webkit-user-select: none;
        user-select: none;
    }

    body::after {
        content: " ";
        display: block;
        position: fixed;
        top: 0; left: 0; bottom: 0; right: 0;
        background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.4) 50%), linear-gradient(90deg, rgba(0, 255, 242, 0.04), rgba(255, 46, 146, 0.02), rgba(123, 47, 247, 0.04));
        z-index: 999;
        background-size: 100% 4px, 6px 100%;
        pointer-events: none;
    }

    header { text-align: center; width: 100%; max-width: 400px; flex-shrink: 0; padding: 2px 0; }

    h1 {
        margin: 4px 0 8px 0;
        font-family: 'Press Start 2P', 'Courier New', monospace;
        font-size: 0.85rem;
        font-weight: 400;
        color: #fff;
        text-shadow: 0 0 6px var(--text-color), 0 0 16px var(--accent-color), 0 0 28px var(--neon-purple);
        letter-spacing: 1px;
    }

    .status-container {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 2px;
        padding: 4px 10px;
        font-size: 0.8rem;
        border: 2px solid var(--text-color);
        background: #000;
        box-shadow: 0 0 15px rgba(0, 255, 242, 0.25), inset 0 0 10px rgba(255, 46, 146, 0.08);
    }

    #game-area {
        position: relative;
        width: 100%;
        max-width: 320px;
        aspect-ratio: 10 / 20;
        flex-grow: 1;
        flex-shrink: 1;
        min-height: 140px;
        margin: 8px 0;
        border: 3px solid var(--text-color);
        background-color: #05010f;
        overflow: hidden;
        box-sizing: border-box;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 0 25px rgba(0, 255, 242, 0.35), 0 0 55px rgba(255, 46, 146, 0.15);
        transition: border-color 0.1s;
    }

    #game-canvas { display: block; touch-action: none; }

    @keyframes crash-shake {
        0% { transform: translate(0, 0); }
        10% { transform: translate(-12px, 0); }
        20% { transform: translate(12px, 0); }
        30% { transform: translate(-10px, 0); }
        40% { transform: translate(10px, 0); }
        50% { transform: translate(-7px, 0); }
        60% { transform: translate(7px, 0); }
        70% { transform: translate(-4px, 0); }
        80% { transform: translate(4px, 0); }
        90% { transform: translate(-1px, 0); }
        100% { transform: translate(0, 0); }
    }
    @keyframes flash-red {
        0%, 100% { border-color: var(--text-color); }
        50% { border-color: var(--accent-color); }
    }
    .crash-shake { animation: crash-shake 0.5s ease-out; }
    .flash-red-animation { animation: flash-red 0.3s 3; }

    #boom-text {
        position: absolute;
        top: 50%; left: 50%;
        transform: translate(-50%, -50%) scale(0);
        font-family: 'Press Start 2P', monospace;
        font-size: clamp(1.1rem, 8vw, 1.8rem);
        color: #fff;
        text-shadow: 0 0 8px var(--neon-yellow), 0 0 24px var(--accent-color), 0 0 48px var(--accent-color);
        letter-spacing: 2px;
        z-index: 30;
        opacity: 0;
        pointer-events: none;
        white-space: nowrap;
        text-align: center;
    }
    #boom-text.show { animation: boom-pop 0.75s ease-out forwards; }
    @keyframes boom-pop {
        0%   { transform: translate(-50%, -50%) scale(0.2) rotate(-8deg); opacity: 0; }
        15%  { transform: translate(-50%, -50%) scale(1.35) rotate(5deg); opacity: 1; }
        30%  { transform: translate(-50%, -50%) scale(1) rotate(-2deg); opacity: 1; }
        78%  { transform: translate(-50%, -50%) scale(1) rotate(0deg); opacity: 1; }
        100% { transform: translate(-50%, -50%) scale(1.12) rotate(0deg); opacity: 0; }
    }

    .overlay {
        position: absolute;
        top: 0; left: 0; width: 100%; height: 100%;
        background: rgba(5, 1, 15, 0.92);
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        z-index: 10;
        padding: 10px;
        box-sizing: border-box;
        text-align: center;
    }
    .overlay h2 {
        font-family: 'Press Start 2P', monospace;
        font-size: 1rem;
        color: var(--accent-color);
        margin-bottom: 14px;
        text-shadow: 0 0 8px var(--accent-color), 0 0 20px var(--neon-purple);
        letter-spacing: 2px;
        text-align: center;
    }
    .overlay p { margin: 5px 0; font-size: 0.9rem; letter-spacing: 1px; color: var(--text-color); }

    footer { width: 100%; max-width: 400px; text-align: center; flex-shrink: 0; margin-top: auto; }

    .action-button-container {
        width: 100%; height: auto; margin-bottom: 8px; display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 6px;
    }
    .btn-action {
        background-color: transparent; color: var(--text-color); border: 2px solid var(--text-color);
        padding: 8px 26px; font-family: 'Press Start 2P', monospace; font-size: 0.7rem; font-weight: 400; cursor: pointer;
        box-shadow: 0 0 10px rgba(0, 255, 242, 0.4); letter-spacing: 1px; display: inline-block;
    }
    .btn-action:hover, .btn-action:active { background-color: var(--text-color); color: #000; box-shadow: 0 0 20px var(--text-color); }

    .score-board-container {
        display: flex; justify-content: space-between; width: 95%; margin: 0 auto 10px auto;
        font-size: 0.75rem; border-top: 1px dashed rgba(0, 255, 242, 0.3); padding-top: 6px; text-align: left;
    }
    .hi-score-box { width: 45%; color: #fff; text-shadow: 0 0 5px #fff; }
    .hi-score-box span { color: var(--neon-yellow); font-size: 1.1rem; font-weight: bold; display: block; margin-top: 2px; }
    .history-box { width: 50%; text-align: right; max-height: 48px; overflow-y: auto; font-family: monospace; font-size: 0.7rem; color: #b18cf0; line-height: 1.2; padding-right: 2px; }
    .history-box::-webkit-scrollbar { width: 3px; }
    .history-box::-webkit-scrollbar-thumb { background: var(--text-color); }

    .controls {
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: 94%;
        margin: 0 auto;
        gap: 8px;
    }
    .btn-touch {
        font-size: 1.6rem; display: flex; justify-content: center; align-items: center;
        border-radius: 50%; touch-action: manipulation; user-select: none; cursor: pointer; transition: all 0.1s ease;
        background: rgba(0, 255, 242, 0.12); border: 2px solid var(--text-color); color: var(--text-color);
        box-shadow: 0 0 12px rgba(0, 255, 242, 0.3);
    }
    .btn-touch:hover, .btn-touch:active, .btn-touch.touch-active {
        background: var(--text-color) !important; color: #000 !important; box-shadow: 0 0 25px var(--text-color) !important;
    }
    .btn-label {
        font-size: 0.5rem;
        font-family: 'Press Start 2P', monospace;
        display: block;
        margin-top: 4px;
        letter-spacing: 0;
    }
    .control-wrap { display: flex; flex-direction: column; align-items: center; }

    /* Rotate button: bigger, on its own (left thumb) */
    #btn-rotate { width: 66px; height: 66px; font-size: 1.9rem; }

    /* D-pad cluster: left / right on top row, down centered below (right thumb) */
    .dpad {
        display: grid;
        grid-template-columns: 54px 54px 54px;
        grid-template-rows: 54px 54px;
        gap: 6px;
        justify-items: center;
        align-items: center;
    }
    .dpad #btn-left  { grid-column: 1; grid-row: 1; width: 54px; height: 54px; }
    .dpad #btn-right { grid-column: 3; grid-row: 1; width: 54px; height: 54px; }
    .dpad #btn-down  { grid-column: 2; grid-row: 2; width: 54px; height: 54px; }

    .next-box {
        position: absolute;
        top: 6px;
        right: 6px;
        z-index: 5;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 2px;
        padding: 3px 6px;
        background: rgba(0, 0, 0, 0.55);
        border: 1px solid var(--text-color);
        border-radius: 4px;
        pointer-events: none;
    }
    .next-box .lbl {
        font-family: 'Press Start 2P', monospace;
        font-size: 0.5rem;
        color: var(--neon-yellow);
        letter-spacing: 1px;
    }
</style>
</head>
<body>

<header>
    <h1>CYBER BLOCKS - MATRIX TRIS</h1>
    <div class="status-container">
        <div>SCORE: <span id="score">0</span></div>
        <div>LEVEL: <span id="level">1</span></div>
        <div>LINES: <span id="lines">0</span></div>
        <div>HI &nbsp;: <span id="hi-inline">0</span></div>
    </div>
</header>

<div id="game-area">
    <canvas id="game-canvas"></canvas>

    <div class="next-box">
        <span class="lbl">NEXT</span>
        <canvas id="next-canvas" width="56" height="56"></canvas>
    </div>

    <div id="boom-text">GAME OVER!!</div>

    <div id="start-overlay" class="overlay">
        <h2>MATRIX TRIS</h2>
        <p>TAP START [SPACE]</p>
        <p style="font-size:0.7rem; opacity:0.8;">⟲回転　←→移動　↓落下</p>
    </div>

    <div id="gameover-overlay" class="overlay" style="display: none;">
        <h2>GAME OVER</h2>
        <p>FINAL SCORE: <span id="final-score">0</span></p>
    </div>
</div>

<footer>
    <div class="action-button-container">
        <button id="start-btn" class="btn-action">START GAME</button>
        <button id="retry-btn" class="btn-action" style="display: none;">PLAY AGAIN</button>
    </div>

    <div class="score-board-container">
        <div class="hi-score-box">
            🏆 HI-SCORE
            <span id="hi-score-display">0</span>
        </div>
        <div class="history-box" id="history-display">
            HISTORY (TOP10)<br>- NO DATA -
        </div>
    </div>

    <div class="controls">
        <div class="control-wrap">
            <button id="btn-rotate" class="btn-touch" aria-label="Rotate">⟲</button>
            <span class="btn-label">ROTATE</span>
        </div>
        <div class="dpad">
            <button id="btn-left" class="btn-touch" aria-label="Left">←</button>
            <button id="btn-right" class="btn-touch" aria-label="Right">→</button>
            <button id="btn-down" class="btn-touch" aria-label="Down">↓</button>
        </div>
    </div>
</footer>

<script>
    // ================= CONSTANTS =================
    const COLS = 10, ROWS = 20;
    const COLORS = {
        I: '#00fff2', O: '#ffe45e', T: '#7b2ff7',
        S: '#39ff88', Z: '#ff2e92', J: '#4d8dff', L: '#ff8a3d'
    };
    const SHAPES = {
        I: [["....","XXXX","....","...."],["..X.","..X.","..X.","..X."],["....","....","XXXX","...."],[".X..",".X..",".X..",".X.."]],
        O: [["XX","XX"],["XX","XX"],["XX","XX"],["XX","XX"]],
        T: [[".X.","XXX","..."],[".X.",".XX",".X."],["...","XXX",".X."],[".X.","XX.",".X."]],
        S: [[".XX","XX.","..."],[".X.",".XX","..X"],[".XX","XX.","..."],[".X.",".XX","..X"]],
        Z: [["XX.",".XX","..."],["..X",".XX",".X."],["XX.",".XX","..."],["..X",".XX",".X."]],
        J: [["X..","XXX","..."],[".XX",".X.",".X."],["...","XXX","..X"],[".X.",".X.","XX."]],
        L: [["..X","XXX","..."],[".X.",".X.",".XX"],["...","XXX","X.."],["XX.",".X.",".X."]]
    };
    const TYPES = ['I','J','L','O','S','T','Z'];

    // ================= STATE =================
    let board = [];
    let piece = null, nextType = null, bag = [];
    let isPlaying = false;
    let score = 0, lines = 0, level = 1;
    let dropInterval = 800, dropAccum = 0, lastTime = 0;
    let hiScore = parseInt(localStorage.getItem('tetris_hi_score')) || 0;
    let scoreHistory = JSON.parse(localStorage.getItem('tetris_history')) || [];
    let audioCtx = null;
    let BLOCK = 20;

    const gameArea = document.getElementById('game-area');
    const canvas = document.getElementById('game-canvas');
    const ctx = canvas.getContext('2d');
    const nextCanvas = document.getElementById('next-canvas');
    const nextCtx = nextCanvas.getContext('2d');
    const boomTextEl = document.getElementById('boom-text');
    const scoreEl = document.getElementById('score'), levelEl = document.getElementById('level'), linesEl = document.getElementById('lines');
    const hiInlineEl = document.getElementById('hi-inline');
    const startOverlay = document.getElementById('start-overlay'), gameoverOverlay = document.getElementById('gameover-overlay'), finalScoreEl = document.getElementById('final-score');
    const startBtn = document.getElementById('start-btn'), retryBtn = document.getElementById('retry-btn');
    const btnRotate = document.getElementById('btn-rotate');
    const btnLeft = document.getElementById('btn-left'), btnRight = document.getElementById('btn-right'), btnDown = document.getElementById('btn-down');
    const hiScoreDisplay = document.getElementById('hi-score-display'), historyDisplay = document.getElementById('history-display');

    // ================= BOARD / PIECE HELPERS =================
    function makeBoard() {
        const b = [];
        for (let r = 0; r < ROWS; r++) b.push(new Array(COLS).fill(null));
        return b;
    }

    function refillBag() {
        bag = TYPES.slice();
        for (let i = bag.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [bag[i], bag[j]] = [bag[j], bag[i]];
        }
    }
    function drawFromBag() {
        if (bag.length === 0) refillBag();
        return bag.pop();
    }

    function createPiece(type) {
        const shape = SHAPES[type];
        const size = shape[0][0].length;
        return {
            type, rotationIndex: 0,
            x: Math.floor((COLS - size) / 2),
            y: type === 'I' ? -1 : -1,
            color: COLORS[type]
        };
    }

    function getCells(type, rotationIndex, ox, oy) {
        const grid = SHAPES[type][rotationIndex];
        const cells = [];
        for (let r = 0; r < grid.length; r++) {
            for (let c = 0; c < grid[r].length; c++) {
                if (grid[r][c] === 'X') cells.push({ x: ox + c, y: oy + r });
            }
        }
        return cells;
    }

    function collidesAt(type, rotationIndex, ox, oy) {
        const cells = getCells(type, rotationIndex, ox, oy);
        for (const c of cells) {
            if (c.x < 0 || c.x >= COLS || c.y >= ROWS) return true;
            if (c.y >= 0 && board[c.y][c.x]) return true;
        }
        return false;
    }

    function spawnPiece() {
        const type = nextType || drawFromBag();
        nextType = drawFromBag();
        piece = createPiece(type);
        drawNextPreview();
        if (collidesAt(piece.type, piece.rotationIndex, piece.x, piece.y)) {
            gameOver();
        }
    }

    function tryMove(dx, dy) {
        if (!collidesAt(piece.type, piece.rotationIndex, piece.x + dx, piece.y + dy)) {
            piece.x += dx; piece.y += dy;
            return true;
        }
        return false;
    }

    function tryRotate() {
        if (!piece || piece.type === 'O') { render(); return; }
        const newRot = (piece.rotationIndex + 1) % 4;
        const kicks = [0, -1, 1, -2, 2];
        for (const k of kicks) {
            if (!collidesAt(piece.type, newRot, piece.x + k, piece.y)) {
                piece.x += k; piece.rotationIndex = newRot;
                playRotateSound();
                render();
                return;
            }
        }
    }

    function hardDrop() {
        if (!piece) return;
        let dist = 0;
        while (tryMove(0, 1)) dist++;
        score += dist * 2;
        playDropSound();
        lockPiece();
    }

    function lockPiece() {
        const cells = getCells(piece.type, piece.rotationIndex, piece.x, piece.y);
        let aboveBoard = false;
        for (const c of cells) {
            if (c.y < 0) { aboveBoard = true; continue; }
            board[c.y][c.x] = piece.color;
        }
        if (aboveBoard) { gameOver(); return; }
        clearLines();
        updateStatus();
        spawnPiece();
        render();
    }

    function clearLines() {
        let cleared = 0;
        for (let r = ROWS - 1; r >= 0; r--) {
            if (board[r].every(cell => cell)) {
                board.splice(r, 1);
                board.unshift(new Array(COLS).fill(null));
                cleared++;
                r++; // re-check same row index after shift
            }
        }
        if (cleared > 0) {
            const points = [0, 100, 300, 500, 800][cleared] * level;
            score += points;
            lines += cleared;
            level = Math.floor(lines / 10) + 1;
            dropInterval = Math.max(120, 800 - (level - 1) * 60);
            playLineSound(cleared);
        }
    }

    // ================= RENDER =================
    let resizeRetryCount = 0;
    function resizeCanvas() {
        const dpr = window.devicePixelRatio || 1;
        const areaW = gameArea.clientWidth;
        const areaH = gameArea.clientHeight;

        // On some mobile browsers the game-area hasn't been laid out yet on the very
        // first call (0 width/height), which used to leave the board stuck at the
        // minimum 8px block size (i.e. effectively broken). If that happens, retry
        // on the next animation frame a few times until layout has settled.
        if ((areaW < 20 || areaH < 20) && resizeRetryCount < 30) {
            resizeRetryCount++;
            requestAnimationFrame(resizeCanvas);
            return;
        }
        resizeRetryCount = 0;

        const bw = Math.floor(areaW / COLS);
        const bh = Math.floor(areaH / ROWS);
        BLOCK = Math.max(8, Math.min(bw, bh));
        canvas.width = BLOCK * COLS * dpr;
        canvas.height = BLOCK * ROWS * dpr;
        canvas.style.width = (BLOCK * COLS) + 'px';
        canvas.style.height = (BLOCK * ROWS) + 'px';
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        render();
    }

    function drawBlock(context, x, y, size, color) {
        context.fillStyle = color;
        context.fillRect(x + 1, y + 1, size - 2, size - 2);
        context.strokeStyle = 'rgba(255,255,255,0.35)';
        context.lineWidth = 1;
        context.strokeRect(x + 1.5, y + 1.5, size - 3, size - 3);
        context.shadowColor = color;
        context.shadowBlur = 6;
        context.strokeStyle = color;
        context.strokeRect(x, y, size, size);
        context.shadowBlur = 0;
    }

    function render() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        ctx.fillStyle = '#08021a';
        ctx.fillRect(0, 0, BLOCK * COLS, BLOCK * ROWS);

        // grid lines
        ctx.strokeStyle = 'rgba(0,255,242,0.08)';
        ctx.lineWidth = 1;
        for (let c = 0; c <= COLS; c++) {
            ctx.beginPath(); ctx.moveTo(c * BLOCK, 0); ctx.lineTo(c * BLOCK, BLOCK * ROWS); ctx.stroke();
        }
        for (let r = 0; r <= ROWS; r++) {
            ctx.beginPath(); ctx.moveTo(0, r * BLOCK); ctx.lineTo(BLOCK * COLS, r * BLOCK); ctx.stroke();
        }

        // locked blocks
        for (let r = 0; r < ROWS; r++) {
            for (let c = 0; c < COLS; c++) {
                if (board[r][c]) drawBlock(ctx, c * BLOCK, r * BLOCK, BLOCK, board[r][c]);
            }
        }

        if (piece) {
            // ghost piece
            let ghostY = piece.y;
            while (!collidesAt(piece.type, piece.rotationIndex, piece.x, ghostY + 1)) ghostY++;
            const ghostCells = getCells(piece.type, piece.rotationIndex, piece.x, ghostY);
            ctx.save();
            ctx.globalAlpha = 0.25;
            for (const c of ghostCells) {
                if (c.y >= 0) drawBlock(ctx, c.x * BLOCK, c.y * BLOCK, BLOCK, piece.color);
            }
            ctx.restore();

            // active piece
            const cells = getCells(piece.type, piece.rotationIndex, piece.x, piece.y);
            for (const c of cells) {
                if (c.y >= 0) drawBlock(ctx, c.x * BLOCK, c.y * BLOCK, BLOCK, piece.color);
            }
        }
    }

    function drawNextPreview() {
        nextCtx.clearRect(0, 0, nextCanvas.width, nextCanvas.height);
        if (!nextType) return;
        const grid = SHAPES[nextType][0];
        const size = grid.length;
        const cell = Math.floor(nextCanvas.width / (size + 1));
        const cells = [];
        for (let r = 0; r < grid.length; r++)
            for (let c = 0; c < grid[r].length; c++)
                if (grid[r][c] === 'X') cells.push({ x: c, y: r });
        const minX = Math.min(...cells.map(p => p.x)), maxX = Math.max(...cells.map(p => p.x));
        const minY = Math.min(...cells.map(p => p.y)), maxY = Math.max(...cells.map(p => p.y));
        const w = (maxX - minX + 1) * cell, h = (maxY - minY + 1) * cell;
        const offX = (nextCanvas.width - w) / 2 - minX * cell;
        const offY = (nextCanvas.height - h) / 2 - minY * cell;
        for (const c of cells) {
            drawBlock(nextCtx, offX + c.x * cell, offY + c.y * cell, cell, COLORS[nextType]);
        }
    }

    function updateStatus() {
        scoreEl.textContent = score;
        levelEl.textContent = level;
        linesEl.textContent = lines;
        hiInlineEl.textContent = hiScore;
    }

    function loadAndRenderScoreBoard() {
        hiScoreDisplay.textContent = hiScore;
        if (scoreHistory.length === 0) {
            historyDisplay.innerHTML = 'HISTORY (TOP10)<br>- NO DATA -';
        } else {
            historyDisplay.innerHTML = 'HISTORY (TOP10)<br>' + scoreHistory.map(s => s).join(', ');
        }
        updateStatus();
    }

    // ================= AUDIO =================
    function initAudio() {
        if (audioCtx) { if (audioCtx.state === 'suspended') audioCtx.resume(); return; }
        audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    }
    function blip(freq, dur, type, gainVal, delay) {
        if (!audioCtx) return;
        const now = audioCtx.currentTime + (delay || 0);
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.type = type || 'square';
        osc.frequency.setValueAtTime(freq, now);
        gain.gain.setValueAtTime(gainVal || 0.2, now);
        gain.gain.exponentialRampToValueAtTime(0.0001, now + dur);
        osc.connect(gain); gain.connect(audioCtx.destination);
        osc.start(now); osc.stop(now + dur);
    }
    function playRotateSound() { blip(520, 0.08, 'square', 0.12); }
    function playMoveSound() { blip(300, 0.05, 'square', 0.08); }
    function playDropSound() { blip(140, 0.12, 'sawtooth', 0.2); }
    function playLineSound(n) {
        const freqs = [660, 880, 1108, 1318];
        for (let i = 0; i < Math.min(n, 4); i++) blip(freqs[i], 0.15, 'triangle', 0.25, i * 0.06);
    }
    function playStartSound() { blip(660, 0.1, 'square', 0.2, 0); blip(990, 0.1, 'square', 0.2, 0.09); }
    function playBoomSound() {
        if (!audioCtx) return;
        const now = audioCtx.currentTime;
        const osc = audioCtx.createOscillator();
        const oscGain = audioCtx.createGain();
        osc.type = 'square';
        osc.frequency.setValueAtTime(130, now);
        osc.frequency.exponentialRampToValueAtTime(22, now + 0.5);
        oscGain.gain.setValueAtTime(0.6, now);
        oscGain.gain.exponentialRampToValueAtTime(0.01, now + 0.5);
        osc.connect(oscGain); oscGain.connect(audioCtx.destination);
        osc.start(now); osc.stop(now + 0.5);
    }

    // ================= GAME FLOW =================
    function initGame() {
        board = makeBoard();
        score = 0; lines = 0; level = 1; dropInterval = 800; dropAccum = 0;
        bag = []; nextType = null;
        spawnPiece();
        loadAndRenderScoreBoard();
        resizeCanvas();
    }

    function startGame() {
        if (isPlaying) return;
        initAudio(); playStartSound();
        isPlaying = true;
        startOverlay.style.display = 'none';
        gameoverOverlay.style.display = 'none';
        startBtn.style.display = 'none'; retryBtn.style.display = 'none';
        gameArea.classList.remove('crash-shake', 'flash-red-animation');
        boomTextEl.classList.remove('show');
        boomTextEl.textContent = 'GAME OVER!!';
        initGame();
        lastTime = 0;
        requestAnimationFrame(gameLoop);
    }

    function gameOver() {
        isPlaying = false;
        playBoomSound();
        gameArea.classList.add('crash-shake', 'flash-red-animation');
        boomTextEl.classList.remove('show');
        void boomTextEl.offsetWidth;
        boomTextEl.classList.add('show');
        setTimeout(() => boomTextEl.classList.remove('show'), 800);

        finalScoreEl.textContent = score;
        if (score >= hiScore) { hiScore = score; localStorage.setItem('tetris_hi_score', hiScore); }
        scoreHistory.unshift(score); if (scoreHistory.length > 10) scoreHistory.pop();
        localStorage.setItem('tetris_history', JSON.stringify(scoreHistory));
        loadAndRenderScoreBoard();

        setTimeout(() => {
            gameoverOverlay.style.display = 'flex';
            retryBtn.style.display = 'inline-block';
        }, 550);
    }

    function gameLoop(t) {
        if (!isPlaying) return;
        if (!lastTime) lastTime = t;
        const dt = t - lastTime;
        lastTime = t;
        dropAccum += dt;
        if (dropAccum >= dropInterval) {
            dropAccum = 0;
            if (!tryMove(0, 1)) lockPiece();
        }
        render();
        requestAnimationFrame(gameLoop);
    }

    // ================= INPUT =================
    window.addEventListener('keydown', (e) => {
        if (!isPlaying) {
            if (e.code === 'Space') startGame();
            return;
        }
        if (['Space','ArrowLeft','ArrowRight','ArrowUp','ArrowDown'].includes(e.code)) e.preventDefault();
        if (e.code === 'ArrowLeft') { if (tryMove(-1, 0)) { playMoveSound(); render(); } }
        if (e.code === 'ArrowRight') { if (tryMove(1, 0)) { playMoveSound(); render(); } }
        if (e.code === 'ArrowUp') tryRotate();
        if (e.code === 'ArrowDown') { if (tryMove(0, 1)) render(); }
        if (e.code === 'Space') hardDrop();
    });

    // Generic press-and-hold repeat helper for the D-pad buttons.
    // Fires once immediately, then repeats faster after a short delay while held.
    function attachRepeat(btn, action, firstDelay, repeatInterval) {
        let timer = null, delayTimer = null;
        const fire = () => { if (isPlaying) action(); };
        const start = (e) => {
            e.preventDefault();
            btn.classList.add('touch-active');
            if (audioCtx) audioCtx.resume();
            fire();
            delayTimer = setTimeout(() => {
                timer = setInterval(fire, repeatInterval);
            }, firstDelay);
        };
        const stop = (e) => {
            if (e) e.preventDefault();
            btn.classList.remove('touch-active');
            clearTimeout(delayTimer); clearInterval(timer);
            timer = null; delayTimer = null;
        };
        btn.addEventListener('touchstart', start, { passive: false });
        btn.addEventListener('touchend', stop);
        btn.addEventListener('touchcancel', stop);
        btn.addEventListener('mousedown', start);
        window.addEventListener('mouseup', stop);
    }

    attachRepeat(btnLeft, () => { if (tryMove(-1, 0)) { playMoveSound(); render(); } }, 220, 90);
    attachRepeat(btnRight, () => { if (tryMove(1, 0)) { playMoveSound(); render(); } }, 220, 90);
    attachRepeat(btnDown, () => { if (tryMove(0, 1)) render(); }, 150, 60);

    btnRotate.addEventListener('touchstart', (e) => { e.preventDefault(); btnRotate.classList.add('touch-active'); if (audioCtx) audioCtx.resume(); if (isPlaying) tryRotate(); });
    btnRotate.addEventListener('touchend', (e) => { e.preventDefault(); btnRotate.classList.remove('touch-active'); });
    btnRotate.addEventListener('click', () => { if (isPlaying) tryRotate(); });

    // Swipe on the board itself as a bonus shortcut: drag left/right to move, tap to rotate.
    let touchStartX = 0, touchStartY = 0, touchMoved = false, lastStepX = 0;
    canvas.addEventListener('touchstart', (e) => {
        if (!isPlaying) return;
        const t = e.touches[0];
        touchStartX = t.clientX; touchStartY = t.clientY; touchMoved = false; lastStepX = 0;
    }, { passive: true });
    canvas.addEventListener('touchmove', (e) => {
        if (!isPlaying || !piece) return;
        const t = e.touches[0];
        const dx = t.clientX - touchStartX;
        const stepX = Math.trunc(dx / BLOCK);
        if (stepX !== lastStepX) {
            const diff = stepX - lastStepX;
            const dir = diff > 0 ? 1 : -1;
            for (let i = 0; i < Math.abs(diff); i++) { if (tryMove(dir, 0)) touchMoved = true; }
            lastStepX = stepX;
            render();
        }
    }, { passive: true });
    canvas.addEventListener('touchend', (e) => {
        if (!isPlaying) return;
        if (!touchMoved) tryRotate();
    });

    startBtn.addEventListener('click', (e) => { e.target.blur(); startGame(); });
    retryBtn.addEventListener('click', (e) => { e.target.blur(); startGame(); });

    window.addEventListener('resize', () => { resizeCanvas(); });
    if (window.ResizeObserver) {
        new ResizeObserver(() => { resizeCanvas(); }).observe(gameArea);
    }
    window.addEventListener('load', () => { resizeCanvas(); });
    if (document.fonts && document.fonts.ready) {
        document.fonts.ready.then(() => { resizeCanvas(); }).catch(() => {});
    }

    // On-screen error display: if anything throws at runtime, show the message
    // directly on the page (instead of it only being visible in a desktop
    // console) so a problem on a phone can actually be read and reported.
    window.addEventListener('error', (e) => {
        try {
            let box = document.getElementById('js-error-box');
            if (!box) {
                box = document.createElement('div');
                box.id = 'js-error-box';
                box.style.cssText = 'position:fixed;left:0;right:0;bottom:0;z-index:99999;background:#3a0000;color:#ff9a9a;font:11px monospace;padding:8px;white-space:pre-wrap;max-height:40vh;overflow:auto;border-top:2px solid #ff2e92;';
                document.body.appendChild(box);
            }
            box.textContent = 'JS ERROR: ' + (e.message || e.error) + '\n' + (e.filename ? (e.filename + ':' + e.lineno) : '');
        } catch (err) { /* ignore */ }
    });

    // initial idle board so it's not blank behind the start overlay
    board = makeBoard();
    loadAndRenderScoreBoard();
    resizeCanvas();
</script>
</body>
</html>
